{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "crypto-me",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "crypto.me",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "0738123a6b3c478294d1e79d47a54570"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "crypto-me"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "PROFILE_REFRESH_QUEUE",
        "queue": "crypto-me-profile-refresh"
      }
    ],
    "consumers": [
      {
        "queue": "crypto-me-profile-refresh",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "retry_delay": 60,
        "max_concurrency": 1,
        "dead_letter_queue": "crypto-me-profile-refresh-dlq"
      }
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": false
    }
  }
}
