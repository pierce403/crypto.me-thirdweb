{
  "name": "crypto.me-thirdweb",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/with-database-url.js prisma generate && next build",
    "cf:build": "opennextjs-cloudflare build && node scripts/sanitize-opennext-env.js",
    "preview": "npm run cf:build && node scripts/with-local-cloudflare-env.js opennextjs-cloudflare preview",
    "deploy": "npm run cf:build && node scripts/with-local-cloudflare-env.js opennextjs-cloudflare deploy -- --keep-vars",
    "upload": "npm run cf:build && node scripts/with-local-cloudflare-env.js opennextjs-cloudflare upload",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:dev": "node scripts/with-database-url.js prisma db push",
    "db:migrate": "node scripts/with-database-url.js prisma migrate dev",
    "db:deploy": "node scripts/with-database-url.js prisma migrate deploy",
    "lint": "next lint",
    "test": "TS_NODE_TRANSPILE_ONLY=1 node --require ./scripts/register-ts.js scripts/run-tests.js",
    "test:e2e": "TS_NODE_TRANSPILE_ONLY=1 node --require ./scripts/register-ts.js tests/e2e-no-demo-data.test.ts"
  },
  "dependencies": {
    "@adraffy/ens-normalize": "^1.11.1",
    "@chakra-ui/react": "^3.19.1",
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@ensdomains/ensjs": "^4.0.2",
    "@opennextjs/cloudflare": "1.20.1",
    "@playwright/test": "^1.52.0",
    "@prisma/adapter-pg": "6.19.2",
    "@prisma/client": "6.19.2",
    "framer-motion": "^12.15.0",
    "next": "15.5.20",
    "next-themes": "^0.4.6",
    "pg": "8.16.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "viem": "^2.30.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260721.1",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.15.29",
    "@types/pg": "8.20.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.28.0",
    "eslint-config-next": "15.5.20",
    "node-mocks-http": "^1.17.2",
    "postcss": "^8",
    "prisma": "6.19.2",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "wrangler": "4.112.0"
  }
}
